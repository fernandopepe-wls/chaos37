# ══════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT — copy this file to .env.development
# App identity (appId, appName) lives in capacitor.config.json
# App version lives in package.json "version"
# ══════════════════════════════════════════════════════════════

# ── Android SDK (local only, not needed in CI) ──────────────
JAVA_HOME=C:\Program Files\Android\Android Studio\jbr
ANDROID_HOME=C:\Users\YOU\AppData\Local\Android\Sdk

# ── OTA ─────────────────────────────────────────────────────
OTA_ENABLED=true
# OTA_BASE_URL=https://ota.games.wildlifestudios.com
# OTA_S3_PREFIX=my-game/staging   (path under CDN; must match GitLab OTA_S3_PREFIX / default project+env)

# ── S3 Storage ──────────────────────────────────────────────
S3_BUCKET=my-game-bucket
S3_REGION=us-east-1
S3_PREFIX=ota/development
AWS_PROFILE=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_ENDPOINT=http://localhost:9000     (MinIO / R2 / non-AWS)

# ── APK Signing ─────────────────────────────────────────────
KEYSTORE_PATH=./release.keystore
KEYSTORE_ALIAS=release
KEYSTORE_PASSWORD=changeme
KEYSTORE_ALIAS_PASSWORD=changeme

# ══════════════════════════════════════════════════════════════
# CI/CD (GitLab) — set these in Settings → CI/CD → Variables:
#
#   S3_BUCKET              — S3 bucket name
#   S3_REGION              — AWS region
#   S3_PREFIX              — Key prefix (e.g. ota/production)
#   S3_ACCESS_KEY          — S3 access key
#   S3_SECRET_KEY          — S3 secret key
#   S3_ENDPOINT            — (optional) Custom S3 endpoint
#   OTA_ENABLED            — "true" to enable OTA
#   OTA_BASE_URL           — (optional) CDN URL override
#   KEYSTORE_BASE64        — Base64-encoded .keystore file
#   KEYSTORE_ALIAS         — Keystore alias
#   KEYSTORE_PASSWORD      — Keystore password
#   KEYSTORE_ALIAS_PASSWORD — Key alias password
#
# To encode your keystore for CI:
#   base64 -w 0 release.keystore > keystore.b64
#   Copy the contents of keystore.b64 into the KEYSTORE_BASE64 variable
#
#   CI_GIT_PUSH_TOKEN      — Project Access Token (write_repository) for OTA version bumps
# ══════════════════════════════════════════════════════════════
