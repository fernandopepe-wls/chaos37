{
  "appId": "com.hackathon37.group34.bunnychaos",
  "appName": "Bunny Chaos!",
  "webDir": "dist",
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 30000
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 500,
      "backgroundColor": "#0a0a0f",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0f"
    }
  },
  "ios": {
    "preferredContentMode": "mobile"
  }
}
